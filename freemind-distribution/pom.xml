<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>freemind</groupId>
        <artifactId>freemind-parent</artifactId>
        <version>1.1.0-beta-2</version>
    </parent>

    <artifactId>freemind-distribution</artifactId>
    <packaging>jar</packaging>
    <name>FreeMind Distribution</name>
    <description>All-inclusive executable FreeMind uberjar</description>

    <dependencies>
        <!-- Core -->
        <dependency>
            <groupId>freemind</groupId>
            <artifactId>freemind-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Plugins -->
        <dependency>
            <groupId>freemind</groupId>
            <artifactId>freemind-plugins</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Skip Java compilation (all code comes from dependencies) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- Shade: create all-inclusive executable uberjar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>uberjar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <finalName>freemind-all</finalName>
                            <outputDirectory>${project.basedir}/../target/dist</outputDirectory>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>freemind.main.FreeMindStarter</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>
                            <filters>
                                <!-- Global: remove signing + module-info -->
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                                <!-- pdf-transcoder is a custom vendored FOP derivative.
                                     Its classes must win over originals. -->
                                <filter>
                                    <artifact>org.apache.xmlgraphics:fop</artifact>
                                    <excludes>
                                        <exclude>org/apache/fop/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- pdf-transcoder has vendored copies of specific xmlgraphics packages -->
                                <filter>
                                    <artifact>org.apache.xmlgraphics:xmlgraphics-commons</artifact>
                                    <excludes>
                                        <exclude>org/apache/xmlgraphics/fonts/**</exclude>
                                        <exclude>org/apache/xmlgraphics/java2d/**</exclude>
                                        <exclude>org/apache/xmlgraphics/ps/**</exclude>
                                        <exclude>org/apache/xmlgraphics/util/io/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.apache.avalon.framework:avalon-framework-api</artifact>
                                    <excludes>
                                        <exclude>org/apache/avalon/framework/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>org.apache.avalon.framework:avalon-framework-impl</artifact>
                                    <excludes>
                                        <exclude>org/apache/avalon/framework/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>commons-io:commons-io</artifact>
                                    <excludes>
                                        <exclude>org/apache/commons/io/**</exclude>
                                    </excludes>
                                </filter>
                                <filter>
                                    <artifact>commons-logging:commons-logging</artifact>
                                    <excludes>
                                        <exclude>org/apache/commons/logging/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- batik-js bundles Rhino; standalone rhino wins -->
                                <filter>
                                    <artifact>org.apache.xmlgraphics:batik-js</artifact>
                                    <excludes>
                                        <exclude>org/mozilla/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- batik-ext overlaps w3c DOM classes with xml-apis; xml-apis wins -->
                                <filter>
                                    <artifact>org.apache.xmlgraphics:batik-ext</artifact>
                                    <excludes>
                                        <exclude>org/w3c/dom/**</exclude>
                                    </excludes>
                                </filter>
                                <!-- QName is JDK-provided; exclude from xpp3 to avoid xml-apis overlap -->
                                <filter>
                                    <artifact>xpp3:xpp3</artifact>
                                    <excludes>
                                        <exclude>javax/xml/namespace/QName*</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Make executable wrapper script (post-package) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-executable</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="/bin/sh" dir="${project.basedir}/../target/dist">
                                    <arg value="-c"/>
                                    <arg value="printf '%s\n' '#!/bin/sh' 'exec java -jar &quot;$$0&quot; &quot;$$@&quot;' > freemind.footer &amp;&amp; cat freemind.footer freemind-all.jar > freemind &amp;&amp; chmod +x freemind &amp;&amp; rm freemind.footer"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
